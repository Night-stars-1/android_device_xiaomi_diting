// SPDX-License-Identifier: Apache-2.0

package {
    default_applicable_licenses: ["diting_mipush_license"],
}

license {
    name: "diting_mipush_license",
    license_kinds: ["SPDX-license-identifier-GPL-3.0"],
    license_text: ["LICENSE"],
}

// Both APKs list androidx.window.extensions and androidx.window.sidecar as optional
// <uses-library> tags; the build must declare the same set for the dexpreopt check.
android_app_import {
    name: "DitingMiPushXmsf",
    apk: "DitingMiPushXmsf.apk",
    product_specific: true,
    preprocessed: true,
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}

android_app_import {
    name: "DitingMiPushManager",
    apk: "DitingMiPushManager.apk",
    product_specific: true,
    preprocessed: true,
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}
